[node name="RulesText" type="Label" parent="HowToPlayModal/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "1. Bumpers and moving enemies knock you backward.

2. Knockback distance charges your Tension meter (0% to 100%).

3. Press [SHIFT] to release an explosive Snapback forward dash!

4. Some gaps are too wide to cross at normal jump. You MUST take hits on purpose to store fuel!

5. Collect gold coins and snap through enemies for bonus points."
autowrap_mode = 2

